# RecruteIA Backend — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env.

# Groq API — get key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_hex_string

# Database — Supabase PostgreSQL (or SQLite for local development)
# Production (Supabase): DATABASE_URL=postgresql://postgres:password@db.XXX.supabase.co:5432/postgres
# Local (SQLite): DATABASE_URL=sqlite:///./data/recruiteia.db
DATABASE_URL=sqlite:///./data/recruiteia.db

# File uploads directory (relative to project root)
UPLOAD_DIR=data/uploads

# spaCy models (sm=fast, md=accurate)
SPACY_MODEL_EN=en_core_web_sm
SPACY_MODEL_FR=fr_core_news_sm

# Token expiry in hours
ACCESS_TOKEN_EXPIRE_HOURS=24

# Production example (replace with your own credentials)
# DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres
